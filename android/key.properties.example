# Copy this file to android/key.properties and fill in your upload keystore details.
# Generate a keystore with:  scripts/generate_android_upload_keystore.ps1
#
# NEVER commit key.properties or *.jks to git.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
